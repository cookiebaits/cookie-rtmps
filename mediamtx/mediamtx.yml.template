# MediaMTX Disconnection Protection Configuration for CookieRTMPS
logLevel: info
logDestinations: [stdout]

# Control API for monitoring and protection management
api: true
apiAddress: 127.0.0.1:9997

metrics: false

# RTMP Server on internal port 19360
# Nginx relays stream feeds to MediaMTX on 19360.
rtmp: true
rtmpAddress: 127.0.0.1:19360
rtmpEncryption: "no"

# Disable unused protocols to conserve resources
rtsp: false
hls: false
webrtc: false
srt: false
moq: false

# Path Defaults: Always Available mode with offline MP4 video protection
pathDefaults:
  source: publisher
  alwaysAvailable: true
  alwaysAvailableFile: "${BRB_VIDEO_PATH}"
  overridePublisher: true
  runOnOnline: python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/protection_hook?event=online&path=' + '$MTX_PATH', timeout=1)" || true
  runOnOffline: python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/protection_hook?event=offline&path=' + '$MTX_PATH', timeout=1)" || true

paths:
  all_others:
