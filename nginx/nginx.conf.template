worker_processes auto;
rtmp_auto_push on;
rtmp_auto_push_reconnect 1s;

events {}

# Stream block for Port Fusion (SNI-based routing)
stream {
    map $ssl_preread_server_name $backend_name {
        ${SERVER_DOMAIN}  http_backend;
        default           rtmp_backend;
    }

    upstream http_backend {
        server 127.0.0.1:8443;
    }

    upstream rtmp_backend {
        server 127.0.0.1:19352;
    }

    server {
        listen 1935;
        proxy_pass $backend_name;
        proxy_protocol on;
        ssl_preread on;
    }
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    # Performance & Stability Settings
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;

    # Cloudflare Real IP (IPv4 only)
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    real_ip_header CF-Connecting-IP;

    client_max_body_size 64M;

    # HTTP Server (Port 80)
    server {
        listen 80;
        server_name ${SERVER_DOMAIN};

        # ACME Challenge for Certbot
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        # Serve static chat.html directly
        location = /chat.html {
            root /usr/local/nginx/html;
        }

        location = /${CHAT_HEX_KEY} {
            alias /usr/local/nginx/html/chat.html;
            default_type text/html;
        }

        location /yt_video_id {
            proxy_pass http://127.0.0.1:8080/yt_video_id;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/ {
            proxy_pass http://127.0.0.1:8080/api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /health {
            proxy_pass http://127.0.0.1:8080/health;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Redirect all other HTTP traffic to HTTPS if domain is set
        location / {
            if ($host = ${SERVER_DOMAIN}) {
                return 301 https://$host$request_uri;
            }
            root /usr/local/nginx/html;
            index index.html;
        }

        # Internal Stats for localhost
        location /stat {
            rtmp_stat all;
            rtmp_stat_stylesheet stat.xsl;
        }
    }

    # HTTPS Server (Internal Port 8443, Fused from 443)
    server {
        listen 8443 ssl;
        server_name ${SERVER_DOMAIN};

        ssl_certificate /etc/letsencrypt/live/${SERVER_DOMAIN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${SERVER_DOMAIN}/privkey.pem;

        # Hardened SSL Settings
        ssl_protocols TLSv1.3;
        ssl_conf_command Ciphersuites TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256;
        ssl_prefer_server_ciphers off;

        location /stat {
            rtmp_stat all;
            rtmp_stat_stylesheet stat.xsl;
        }

        location /stat.xsl {
            root /usr/local/nginx/html;
        }

        location = /chat.html {
            root /usr/local/nginx/html;
        }

        location = /${CHAT_HEX_KEY} {
            alias /usr/local/nginx/html/chat.html;
            default_type text/html;
        }

        location /yt_video_id {
            proxy_pass http://127.0.0.1:8080/yt_video_id;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/ {
            proxy_pass http://127.0.0.1:8080/api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /health {
            proxy_pass http://127.0.0.1:8080/health;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
            root /usr/local/nginx/html;
            index index.html;
        }
    }

    # Stats and Control for Disconnection Protection (Internal Port 8081)
    server {
        listen 8081;
        allow 127.0.0.1;
        deny all;

        location /stat {
            rtmp_stat all;
            rtmp_stat_stylesheet stat.xsl;
        }

        location /control {
            rtmp_control all;
        }
    }
}

rtmp {
    server {
        listen 19352 proxy_protocol;
        listen 19359;
        chunk_size ${CHUNK_SIZE};

        # Throughput, Upload Speed Prioritization & Anti-Disconnect Buffers
        max_message 64M;
        out_queue 16384;
        out_cork 32;
        max_streams 128;
        ack_window 10000000;
        so_keepalive on;

        # Stability and Anti-Disconnect Timeout Adjustments
        ping 30s;
        ping_timeout 15s;
        drop_idle_publisher 20s;
        allow play 127.0.0.1;
        deny play all;

        # Horizontal ingest (OBS publishes here, validated by stream key)
        application ${APP_NAME} {
            live on;
            record off;
            allow play 127.0.0.1;
            allow publish all;
            on_publish http://127.0.0.1:8080/validate?key=$name;
            on_publish_done http://127.0.0.1:8080/publish_done;

            # Ingest only: stream_protection.py forwards to broadcast_h
        }

        # Vertical ingest
        application vertical {
            live on;
            record off;
            allow play 127.0.0.1;
            allow publish all;
            on_publish http://127.0.0.1:8080/validate?key=$name;
            on_publish_done http://127.0.0.1:8080/publish_done;

            # Ingest only: stream_protection.py forwards to broadcast_v
        }

        # Platform output (broadcast_h): fed only by the local protection controller
        application broadcast_h {
            live on;
            record off;
            allow publish 127.0.0.1;
            deny publish all;
            allow play 127.0.0.1;
            deny play all;
            #youtube
            #facebook
            #instagram
            #tiktok
            #kick
            #x
            #twitch
            #trovo
            #rtmp1
            #rtmp2
            #rtmp3
        }

        # Platform output (broadcast_v): fed only by the local protection controller
        application broadcast_v {
            live on;
            record off;
            allow publish 127.0.0.1;
            deny publish all;
            allow play 127.0.0.1;
            deny play all;
            #v_youtube
            #v_facebook
            #v_instagram
            #v_tiktok
            #v_kick
            #v_x
            #v_twitch
            #v_trovo
            #v_rtmp1
        }
    }
}
