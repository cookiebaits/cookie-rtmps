worker_processes auto;
rtmp_auto_push on;
rtmp_auto_push_reconnect 1s;

events {}

# Stream block for Port Fusion (SNI-based routing)
stream {
    map $ssl_preread_server_name $backend_name {
        ${SERVER_DOMAIN}  http_backend;
        default           rtmp_backend;
    }

    upstream http_backend {
        server 127.0.0.1:8443;
    }

    upstream rtmp_backend {
        server 127.0.0.1:19352;
    }

    server {
        listen 1935;
        proxy_pass $backend_name;
        ssl_preread on;
    }
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    # Cloudflare Real IP (IPv4 only)
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    real_ip_header CF-Connecting-IP;

    # HTTP Server (Port 80)
    server {
        listen 80;
        server_name ${SERVER_DOMAIN};

        # ACME Challenge for Certbot
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        # Redirect all HTTP traffic to HTTPS if domain is set
        location / {
            if ($host = ${SERVER_DOMAIN}) {
                return 301 https://$host$request_uri;
            }
            root /usr/local/nginx/html;
            index index.html;
        }

        # Internal Stats for localhost
        location /stat {
            rtmp_stat all;
            rtmp_stat_stylesheet stat.xsl;
        }
    }

    # HTTPS Server (Internal Port 8443, Fused from 443)
    server {
        listen 8443 ssl;
        server_name ${SERVER_DOMAIN};

        ssl_certificate /etc/letsencrypt/live/${SERVER_DOMAIN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${SERVER_DOMAIN}/privkey.pem;

        # Hardened SSL Settings
        ssl_protocols TLSv1.3;
        ssl_conf_command Ciphersuites TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256;
        ssl_prefer_server_ciphers off;

        location /stat {
            rtmp_stat all;
            rtmp_stat_stylesheet stat.xsl;
        }

        location /stat.xsl {
            root /usr/local/nginx/html;
        }

        location / {
            root /usr/local/nginx/html;
            index index.html;
        }
    }

    # Stats for NOALBS (Internal Port 8081)
    server {
        listen 8081;
        allow 127.0.0.1;
        deny all;

        location /stat {
            rtmp_stat all;
            rtmp_stat_stylesheet stat.xsl;
        }
    }
}

rtmp {
    server {
        listen 19352;
        chunk_size ${CHUNK_SIZE};

        # Stability and Security Enhancements
        ping 30s;
        ping_timeout 10s;
        drop_idle_publisher 10s;
        deny play all;

        # Facebook Application
        application facebook {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name;
            push ${FACEBOOK_URL}${FACEBOOK_KEY};
        }

        # Twitch Application
        application twitch {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name;
            push ${TWITCH_URL}${TWITCH_KEY};
        }

        # YouTube Application
        application youtube {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name;
            push ${YOUTUBE_URL}${YOUTUBE_KEY};
        }

        # Kick Application
        application kick {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name;
            push ${KICK_URL}${KICK_KEY};
        }

        # X Application
        application x {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name;
            push ${X_URL}${X_KEY};
        }

        # Generic live application
        application ${APP_NAME} {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name;
            
            #youtube
            #facebook
            #instagram
            #tiktok
            #kick
            #x
            #twitch
        }

        # Vertical application
        application vertical {
            live on;
            record off;
            on_publish http://127.0.0.1:8080/validate?key=$name;

            #v_youtube
            #v_facebook
            #v_instagram
            #v_tiktok
            #v_kick
            #v_x
            #v_twitch
            #v_rtmp1
        }
    }
}
